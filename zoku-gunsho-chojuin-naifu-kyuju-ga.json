   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "里梅",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "すゑとをくゆくみちのへの春風におらぬもなひ日もそての青柳",
