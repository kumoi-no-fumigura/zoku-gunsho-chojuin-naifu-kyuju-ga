   "genre": "",
   "ban": "",
   "side": "",
   "dai": "帰属知春",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "咲ぬへき木猶とをき花にきてかすみをわくる春の山ふみ",
