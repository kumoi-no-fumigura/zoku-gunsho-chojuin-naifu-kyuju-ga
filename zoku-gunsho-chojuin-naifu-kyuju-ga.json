   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "かはらすも猶いて秋か友なはむめてこし月のなれ〳〵し袖",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "堤上霧",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "あきらせき月のよなく開の戸もささぬそしるき人の行かひ",
   "kana": "",
   "speaker": "正親町少将季康",
   "page": 7,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関月",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "名にしおふなにて入江の月も今猶久かたの虫にすむらん",
   "kana": "",
   "speaker": "万里小路充房",
   "page": 7,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "江月",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "なみの上のあかぬなかめ月楽計に松そ名多かき志賀のから加勢",
   "kana": "",
   "speaker": "松木中納言宗満",
   "page": 7,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湖月",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "見る〳〵もなかき夜かぬ月にこそ千世よろつ世の秋をちきうめ",
   "kana": "",
   "speaker": "岡基継",
   "page": 7,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "終夜月",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "こゝろある隣なりけりぬる程はうち北之たえたるさ夜衣かな",
   "kana": "",
   "speaker": "祭主慶忠",
   "page": 7,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "隣擣衣",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "詠あかぬ籬のきくの末葉まて千とせの秋を猶やちきらむ",
   "kana": "",
   "speaker": "一勧修寺弁光豊",
   "page": 7,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "翫菊花",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "しられつかみねは夕日の顔に猶わきて紅葉のふるき色かな",
   "kana": "",
   "speaker": "鷲井侍従雅賢",
   "page": 7,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "嶺紅葉嶺紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "秋とても紅葉をよ所のときは山常みそつゝや行ゑいそかむ",
   "kana": "",
   "speaker": "三条西実條",
   "page": 8,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山路秋過",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "冬のきて空いく廻りしくるとも千とせの松濃色はかはらし",
   "kana": "",
   "speaker": "柳原宮内権大輔資淳",
   "page": 8,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初冬時雨",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "かきりなくつもる木の葉はちりひちの山とやならむ霜のあけた",
   "kana": "",
   "speaker": "庭田中納言重通",
   "page": 8,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉帯霜落葉帯霜",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "寒き夜も月にめてつゝ久方のそらをあふきて万代やへ葬",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒夜月",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "にほの海や氷に彼はおさまりて松に音するしかの浦風",
   "kana": "",
   "speaker": "極臈清原秀賢",
   "page": 8,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湖上水",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "あた浪もたさぬ渕とや驚鴫のみなれて床をはなれさならん",
   "kana": "",
   "speaker": "昌北景敏",
   "page": 8,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "渕水鳥",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "なみの音もたかしのはまの塩かせにたちさはきてやちとり鳴らん",
   "kana": "",
   "speaker": "持明院侍従基久",
   "page": 8,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浜千鳥",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "暮るまてかへりもやらすす衛遠きかた野のみ能ゝありぬ狩はし",
   "kana": "",
   "speaker": "九条為良",
   "page": 8,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鷹狩日暮",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "をのつからふかき林の木の万より声たかしれやうたふ榊葉",
   "kana": "",
   "speaker": "阿野侍従実顕",
   "page": 8,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "林神楽",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "とふ人のこゝろあさくは老とふる雪の砌やけみ覚わけまし",
   "kana": "",
   "speaker": "藤右衛門督永孝",
   "page": 8,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭雷厭人",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "雪裳日もつもるかうへにあふきみ舞空井に地かき山となるまて",
   "kana": "",
   "speaker": "中出大納言親綱",
   "page": 9,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一遂日雪深",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "小野山やすこともみえぬ雪のうちにけふりそしるきおくのすみかま",
   "kana": "",
   "speaker": "下冷泉為将",
   "page": 9,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遠炭竈",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "風さゆるあしろの床の夜をかさね月をかたしく浪の音かな",
   "kana": "",
   "speaker": "四条侍従隆忠",
   "page": 9,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "網代",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "冬こも類出紀ねの梅に待春とまつえる物やうつみ火の本",
   "kana": "",
   "speaker": "正親町三条中納言公仲",
   "page": 9,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "向炉火",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "冬の夜もやゝ明かさになりにけりほとけの御名をとなへ残して",
   "kana": "",
   "speaker": "大炊御門大納言経頼",
   "page": 9,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "仏名",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "春ちかきほとしおもへは咲ぬへきはなにわすり年の暮かな",
   "kana": "",
   "speaker": "烏丸弁光広",
   "page": 9,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳暮",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "世もとふる山のすまゐのね覚をもなくさめけりな灯のうせ",
   "kana": "",
   "speaker": "葉室頼宣",
   "page": 9,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山館燈",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "分のほるうへよりうへも榊葉のなをいや高きあまの音久山",
   "kana": "",
   "speaker": "西洞院侍従時康",
   "page": 9,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山椒",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "ゆく衛まておなしよはひと馴きつる手かひの鶴の声そふりせぬ",
   "kana": "",
   "speaker": "民部卿法印玄以",
   "page": 9,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "愛鶴",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "春くれて木ふかき嶺も咲つゝ倶しら玉つはき知へにそ行",
   "kana": "",
   "speaker": "井家右衛門太夫豊家",
   "page": 9,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "嶺椿",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "藻塩やく軒ものけふり立のほるそらや北みたえし須磨入浦かせ",
   "kana": "",
   "speaker": "速水左衛門太夫友益",
   "page": 10,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "塩屋煙",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "うこきもき岩ほの上にむ聞苦の縁や千世の春にあはまし",
   "kana": "",
   "speaker": "坊城中納言盛長",
   "page": 10,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山厳吉",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "苫をあら見田面の庵にすむ民もときをたへぬ雨はいとはす",
   "kana": "",
   "speaker": "新蔵人小槻孝亮",
   "page": 10,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一田家雨",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "かり衣よをかさねくも音やたゝみやこのかたのまれはみゆらん",
   "kana": "",
   "speaker": "九条中将兼治",
   "page": 10,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅泊夢",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "三笠山さしてそちきる松かえのいさ十かへりの春を待つゝ",
   "kana": "",
   "speaker": "紹巴",
   "page": 10,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "名所松",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "つかへきて見てるよはひも五重に猶加そへてよ百とせのくれ",
   "kana": "",
   "speaker": "関白秀次",
   "page": 10,
   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "祝言",
   "kotobagaki": ""
  }
 ],
