   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "翫花",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "うつし植て花のあるしと今年よりいく代の春かかけて楽さゝん",
