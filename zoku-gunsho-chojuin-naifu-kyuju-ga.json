   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初花",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "なれ〳〵て春やかそへむ咲花はみても見まくのほしき色童に",
