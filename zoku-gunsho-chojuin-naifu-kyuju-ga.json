   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "二月余寒",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "春の夜のあかぬなめの有明に千ゝの秋をや猶ちきうまし",
