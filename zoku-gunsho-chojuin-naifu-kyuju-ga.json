   "pid": "nao-734040",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "答梅",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "色も香もかはらぬ春のよゝをへて梅さへりはゆたかにそすむ",
