   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "行路柳",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "あか玉のはるも半にうつる日の空さへ寒き朝あらしかな",
