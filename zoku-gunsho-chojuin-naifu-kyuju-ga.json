   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花主",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "かけたかく色にさくらのなみ木こそむへも雲井の花と見ゆらめ",
